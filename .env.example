# Single env file for the whole app (frontend + backend). Copy to .env and fill in.
# On Vercel, set the same variables in Project Settings > Environment Variables.

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/EduSage?retryWrites=true&w=majority

# Secret used to sign login tokens (any long random string)
JWT_SECRET=

# Google Gemini API key (used by the frontend AI features and the backend PDF parser)
VITE_GEMINI_API_KEY=

# Local backend port
PORT=5000
